# SECURITY WARNING: keep the secret key used in production secret!
# REQUIRED. Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# REQUIRED. Database URL for the application user (never root).
# docker-compose builds it from MYSQL_PASSWORD; MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD must also be set below.
DATABASE_URL=mysql://filatrucking:CHANGE_ME@mysql:3306/filatrucking

# CSRF Trusted Origins (comma-separated list)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Redis Broker URL for Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Shared secret between Django and the WhatsApp sidecar (both directions).
# REQUIRED, no default. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# docker-compose passes it to Django as WHATSAPP_INGEST_SECRET and to the sidecar as DJANGO_SECRET.
WHATSAPP_INGEST_SECRET=

# Used by the mysql container (docker-compose). Choose long random values.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
